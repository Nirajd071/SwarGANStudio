# Ignore everything in checkpoints/
checkpoints/*

# But keep .pth files (Git LFS will handle them)
!checkpoints/*.pth

# Local virtual environment
.venv/
.python-version

# Python caches
__pycache__/
*.pyc

# Packaging / build artifacts
*.egg-info/
build/
dist/

# Generated audio / caches
audio_cache/*
!audio_cache/.gitkeep
